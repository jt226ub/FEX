<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Lets a hardened-runtime program map MAP_JIT memory. This is the only JIT
       entitlement the port should need; it must not need allow-unsigned-executable-memory. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
</dict>
</plist>
